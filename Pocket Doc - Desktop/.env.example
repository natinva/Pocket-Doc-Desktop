POCKETDOC_ENV=development
POCKETDOC_HOST=0.0.0.0
POCKETDOC_PORT=8765
POCKETDOC_MODEL_BASE_DIR=/absolute/path/to/PocketDoc/Modeller
POCKETDOC_INFERENCE_BACKEND=mock
POCKETDOC_UPLOAD_DIR=uploads
POCKETDOC_DATA_DIR=data
POCKETDOC_REPORTS_DIR=reports
POCKETDOC_DATABASE_PATH=data/pocketdoc.sqlite3
POCKETDOC_AUDIT_LOG_PATH=data/audit.log

# Device security
# Recommended: generate a hash with:
# python -m pocketdoc_desktop.security 1234
# Then paste the output into POCKETDOC_DEVICE_PIN_HASH.
POCKETDOC_DEVICE_PIN_HASH=
POCKETDOC_PIN_HASH_ITERATIONS=390000

# Legacy fallback only. Avoid using plaintext PIN in production-like devices.
POCKETDOC_DEVICE_PIN=
POCKETDOC_LOCK_TIMEOUT_SECONDS=900
POCKETDOC_ACCESS_TOKEN_TTL_SECONDS=3600
POCKETDOC_LOCAL_ONLY_MODE=true
POCKETDOC_AUDIT_LOG_ENABLED=true

OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
